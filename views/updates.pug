doctype html
html
  head
    title= title
    meta(name="viewport", content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")

  body
    .container

      h1 Add a Book
      p.subtitle Create a new book record in your HubSpot custom object.

      .form-card

        form(action="/update-cobj", method="POST")

          .form-group
            label(for="name") Name
            input#name(
              type="text"
              name="name"
              placeholder="Enter book name"
              required
            )

          .form-group
            label(for="author") Author
            input#author(
              type="text"
              name="author"
              placeholder="Enter author name"
              required
            )

          .form-group
            label(for="genre") Genre
            input#genre(
              type="text"
              name="genre"
              placeholder="Enter book genre"
              required
            )

          button(type="submit") Add Book

      a.back-link(href="/") ← Return to the homepage